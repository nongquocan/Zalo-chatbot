# Biến môi trường — sao chép file này thành .env và điền giá trị thực

# ====== Google Gemini ======
GEMINI_API_KEY=

# ====== Zalo OA (điền sau khi đăng ký) ======
# App ID + Secret Key lấy từ app tạo trên Zalo for Developers, gắn với OA thật.
# Có đủ 2 giá trị này thì hệ thống mới tự động làm mới access token được.
ZALO_APP_ID=your_zalo_app_id_here
ZALO_APP_SECRET=your_zalo_app_secret_here
# refresh_token lấy được 1 LẦN DUY NHẤT từ bước đổi authorization code ban đầu
# (chủ OA phải tự authorize app qua trình duyệt). Chỉ dùng để "mồi" lần chạy
# đầu tiên — sau đó hệ thống tự lưu refresh_token mới vào DB (chatbot.db),
# không cần sửa giá trị này nữa.
ZALO_REFRESH_TOKEN_SEED=your_initial_refresh_token_here
# (Tuỳ chọn) access token tĩnh dán tạm để test nhanh khi CHƯA có APP_ID/SECRET
# — sẽ tự hết hạn sau ~1 giờ và không được tự động làm mới.
ZALO_OA_TOKEN=
# Zalo user_id của chủ shop — nơi nhận thông báo khi có tin nhắn cần fallback.
# Lưu ý: chủ shop phải từng nhắn cho OA trong 7 ngày gần nhất (qua OpenAPI) mới
# nhận được tin CS message dạng này (giới hạn chính sách Zalo OA).
ZALO_OWNER_ID=your_zalo_user_id_here

# ====== Admin Dashboard (bảo vệ /admin, /stats, /orders, /api/conversations) ======
# Để trống ADMIN_PASSWORD = các trang trên vẫn MỞ CÔNG KHAI (chỉ nên dùng khi
# dev/demo nội bộ). Bắt buộc đặt trước khi expose server ra internet (vd. ngrok).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ====== App Settings ======
APP_NAME=AI Zalo OA Chatbot - Bếp Sạch Việt
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ====== Conversation Settings ======
MAX_HISTORY_TURNS=10
SESSION_TIMEOUT_MINUTES=30

# ====== Ngrok (chạy local qua run.py, dùng khi chưa có server/domain thật) ======
# Domain tĩnh MIỄN PHÍ lấy tại dashboard.ngrok.com -> Domains -> New Domain.
# Để trống thì mỗi lần chạy `python run.py` sẽ ra 1 URL ngẫu nhiên khác nhau.
NGROK_DOMAIN=
